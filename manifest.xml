     <Control xsi:type="Button" id="Picker.Settings"><Label resid="Settings.Label"/><Supertip><Title resid="Settings.Label"/><Description resid="Settings.Desc"/></Supertip><Icon><bt:Image size="16" resid="Icon.Url"/><bt:Image size="32" resid="Icon.Url"/><bt:Image size="80" resid="Icon.Url"/></Icon><Action xsi:type="ShowTaskpane"><SourceLocation resid="Background.Url"/></Action></Control>
