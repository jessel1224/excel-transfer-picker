   </DesktopFormFactor>
  </Host></Hosts>
  <Resources>
   <bt:Images><bt:Image id="Icon.Url" DefaultValue="https://jessel1224.github.io/excel-transfer-picker/icon.png"/></bt:Images>
   <bt:Urls><bt:Url id="Background.Url" DefaultValue="https://jessel1224.github.io/excel-transfer-picker/background-v3.html"/></bt:Urls>
