     <Control xsi:type="Button" id="Picker.Enable"><Label resid="Enable.Label"/><Supertip><Title resid="Enable.Label"/><Description resid="Enable.Desc"/></Supertip><Icon><bt:Image size="16" resid="Icon.Url"/><bt:Image size="32" resid="Icon.Url"/><bt:Image size="80" resid="Icon.Url"/></Icon><Action xsi:type="ExecuteFunction"><FunctionName>enablePicker</FunctionName></Action></Control>
     <Control xsi:type="Button" id="Picker.Stop"><Label resid="Stop.Label"/><Supertip><Title resid="Stop.Label"/><Description resid="Stop.Desc"/></Supertip><Icon><bt:Image size="16" resid="Icon.Url"/><bt:Image size="32" resid="Icon.Url"/><bt:Image size="80" resid="Icon.Url"/></Icon><Action xsi:type="ExecuteFunction"><FunctionName>stopPicker</FunctionName></Action></Control>
